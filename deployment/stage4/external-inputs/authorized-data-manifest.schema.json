{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.example/schemas/authorized-data-manifest.schema.json",
  "title": "AgentGuard authorised data manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset_id",
    "dataset_schema_version",
    "owner_approval_reference",
    "approved_purpose",
    "allowed_fields",
    "expires_at",
    "source_hash_sha256",
    "record_count",
    "retention_and_deletion_reference",
    "side_effects_allowed"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "owner_approval_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Reference only; do not embed signed approval documents."
    },
    "approved_purpose": {
      "type": "string",
      "minLength": 1
    },
    "allowed_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prohibited_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_hash_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "retention_and_deletion_reference": {
      "type": "string",
      "minLength": 1
    },
    "side_effects_allowed": {
      "const": false
    }
  }
}
