# Non-secret production-mode settings. Values are placeholders and must be
# adapted to the authorised target. Passwords and private keys stay in the
# platform secret manager.
KC_HOSTNAME=https://identity.example.invalid
KC_HOSTNAME_ADMIN=https://identity-admin.example.invalid
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=false
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_CACHE=ispn
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://database.example.invalid:5432/keycloak
KC_HTTPS_CERTIFICATE_FILE=/run/secrets/keycloak/tls.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/run/secrets/keycloak/tls.key

# Secret references expected from the deployment system; no values here.
KC_DB_USERNAME=
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
