{
  "schema_version": 1,
  "environment": "authorised-test-or-preproduction-only",
  "directory_federation": {
    "provider": "ldap-or-active-directory",
    "tls_required": true,
    "bind_credential_source": "external-secret-manager",
    "user_attribute_mapping_reviewed": false,
    "periodic_sync_tested": false,
    "disabled_user_propagation_tested": false,
    "group_and_role_mapping_tested": false
  },
  "real_mfa": {
    "allowed_methods": [
      "totp",
      "webauthn",
      "passkey"
    ],
    "dedicated_test_accounts": true,
    "self_enrolment_or_operator_approval_documented": false,
    "step_up_flow_tested": false,
    "replay_rejected": false,
    "lost_device_recovery_reviewed": false
  },
  "high_availability": {
    "minimum_nodes": 2,
    "production_database": true,
    "session_cache_strategy_reviewed": false,
    "load_balancer_ready_endpoint": "/health/ready",
    "node_failure_tested": false,
    "site_failure_tested": false
  },
  "warning": "False values are acceptance gaps, not completed controls."
}
