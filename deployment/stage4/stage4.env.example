# Copy values into a local secret manager or process environment. Do not commit
# a populated copy of this file. The preflight records presence only.

AGENTGUARD_STAGE4_CONFIG=deployment/stage4/stage4.preflight.local.json

# OpenBao least-privilege read/operator-test token.
AGENTGUARD_STAGE4_OPENBAO_TOKEN=

# Path to an authorised, least-privilege Kubernetes kubeconfig.
AGENTGUARD_STAGE4_KUBECONFIG=

# Keycloak test credentials. Use a dedicated non-production realm/account.
AGENTGUARD_STAGE4_KEYCLOAK_ADMIN_TOKEN=
AGENTGUARD_STAGE4_LDAP_BIND_SECRET=
AGENTGUARD_STAGE4_MFA_TEST_CREDENTIAL=

# Real adapter variables. These names intentionally match production_api.py
# and run_authorized_business_api_e2e.py exactly.
AGENTGUARD_BUSINESS_API_BASE_URL=
AGENTGUARD_BUSINESS_API_ALLOWED_HOSTS=
AGENTGUARD_BUSINESS_API_TOKEN=
AGENTGUARD_BUSINESS_API_CA_BUNDLE=
AGENTGUARD_BUSINESS_API_TIMEOUT_SECONDS=5
AGENTGUARD_BUSINESS_ENVIRONMENT=
AGENTGUARD_ALLOW_PRODUCTION_SIDE_EFFECTS=leave-empty-for-read-only
AGENTGUARD_BUSINESS_MAX_WRITE_AMOUNT=0
AGENTGUARD_REQUESTER_OIDC_ISSUER=
AGENTGUARD_REQUESTER_OIDC_AUDIENCE=
AGENTGUARD_QUERY_REQUESTER_ACCESS_TOKEN=

# Required only when the exact preproduction write confirmation is supplied.
AGENTGUARD_WRITE_REQUESTER_ACCESS_TOKEN=
AGENTGUARD_APPROVER_OIDC_ISSUER=
AGENTGUARD_APPROVER_OIDC_AUDIENCE=
AGENTGUARD_APPROVER_ACCESS_TOKEN=

AGENTGUARD_AUTHORIZED_DATA_JSONL=
AGENTGUARD_AUTHORIZED_DATA_MANIFEST=
# At least 64 hexadecimal characters, generated and stored outside Git.
AGENTGUARD_REDACTION_SALT_HEX=
