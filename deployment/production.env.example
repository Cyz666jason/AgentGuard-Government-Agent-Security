# Never commit real values. Load them from the deployment secret manager.
AGENTGUARD_BUSINESS_API_BASE_URL=https://erp-preprod.example.gov.cn
AGENTGUARD_BUSINESS_API_ALLOWED_HOSTS=erp-preprod.example.gov.cn
AGENTGUARD_BUSINESS_API_TOKEN=replace-from-secret-manager
AGENTGUARD_BUSINESS_API_CA_BUNDLE=C:\path\to\organization-ca.pem
AGENTGUARD_BUSINESS_API_TIMEOUT_SECONDS=5

# Writes stay disabled unless all values below are explicitly supplied for PREPRODUCTION.
AGENTGUARD_BUSINESS_ENVIRONMENT=preproduction
AGENTGUARD_ALLOW_PRODUCTION_SIDE_EFFECTS=leave-empty-for-read-only
AGENTGUARD_BUSINESS_MAX_WRITE_AMOUNT=0
AGENTGUARD_REQUESTER_OIDC_ISSUER=https://id-preprod.example.gov.cn/realms/agentguard
AGENTGUARD_REQUESTER_OIDC_AUDIENCE=agentguard
AGENTGUARD_QUERY_REQUESTER_ACCESS_TOKEN=replace-from-secret-manager
AGENTGUARD_WRITE_REQUESTER_ACCESS_TOKEN=replace-from-secret-manager
AGENTGUARD_APPROVER_OIDC_ISSUER=https://id-preprod.example.gov.cn/realms/agentguard
AGENTGUARD_APPROVER_OIDC_AUDIENCE=agentguard
AGENTGUARD_APPROVER_ACCESS_TOKEN=replace-from-secret-manager

# A new random 32-byte salt encoded as 64 hexadecimal characters.
AGENTGUARD_REDACTION_SALT_HEX=replace-from-secret-manager
